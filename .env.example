# ---------------------------------------------------------------------------
# docker-compose overrides. Copy to `.env` (git-ignored) and edit as needed.
# Every value has a sane default in docker-compose.yml, so `docker compose up`
# already works WITHOUT this file. Set these for real secrets / production.
# ---------------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=ft
POSTGRES_PASSWORD=ft_password
POSTGRES_DB=ft_transcendence

# --- Exposed ports (host side) ---
HTTP_PORT=80
HTTPS_PORT=443
MAILDEV_WEB_PORT=1080

# --- App ---
# Public URL of the app (used for CORS + the 42 OAuth callback redirect).
FRONTEND_URL=https://localhost
# REQUIRED in production — generate a strong 64+ char secret:
#   openssl rand -hex 32
JWT_SECRET=dev_only_change_me_0000000000000000000000000000000000000000000000

# --- Mail ---
# Demo default: Maildev SMTP sink (read codes at http://localhost:1080).
# For real email, comment SMTP_* and set GMAIL_USER / GMAIL_APP_PASSWORD instead.
SMTP_HOST=maildev
SMTP_PORT=1025
MAIL_FROM=no-reply@ft-transcendence.local
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# --- 42 OAuth (optional; email/password login works without it) ---
FT_OAUTH_CLIENT_ID=placeholder
FT_OAUTH_CLIENT_SECRET=placeholder
FT_OAUTH_REDIRECT_URI=https://localhost/api/auth/42/callback

# --- Pusher realtime (optional; leave empty/placeholder to use polling) ---
PUSHER_APP_ID=000000
PUSHER_KEY=
PUSHER_SECRET=placeholder
PUSHER_CLUSTER=eu
