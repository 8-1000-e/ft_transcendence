// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  moduleFormat = "cjs"
  provider     = "prisma-client"
  output       = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  //42 data
  ftId          String?        @unique
  login         String? // real 42 login (immutable handle); `name` is the editable pseudo
  ftPfpUrl      String?
  campus        String?
  campusId      String?
  canSuggest    Boolean        @default(true)
  //
  //anon random data
  rdmName       String?
  rdmPfp        String?
  rdmCampus     String?
  //
  name          String
  email         String         @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime       @default(now()) // touched on activity → online status
  tokenVersion  Int            @default(0) // bumped on password change → invalidates old access tokens
  refreshTokens RefreshToken[]
  groupChats    GroupChat[]
  projectPosts  ProjectsPost[]
  projectChat   ProjectsChat[]
  postVote      PostVote[]
  chatVote      ChatVote[]
  friendsSent     Friendship[]   @relation("FriendRequester")
  friendsReceived Friendship[]   @relation("FriendAddressee")
  notifications   Notification[] @relation("NotifRecipient")
  deleteAt      DateTime? // Null = active else deletion programmed
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String       @id @default(uuid())
  requesterId String
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

enum NotifType {
  COMMENT
  REPLY
  MESSAGE
  FRIEND_REQUEST
  FRIEND_ACCEPT
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   User      @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotifType
  actorId     String? // who triggered it (for avatar)
  actorName   String? // display-name snapshot (recipient is always a 42 member)
  entityLabel String? // e.g. post title / group name
  link        String? // frontend route to open
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([recipientId, read])
}

model PendingRegistration {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  createdAt          DateTime @default(now())
  verifCode          String
  verifCodeExpiresAt DateTime
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ProjectGroup {
  id          String      @id
  githubLink  String?
  groupName   String
  projectId   String
  groupCampus String?
  projectName String?
  usersId     String[]
  chats       GroupChat[]
}

model GroupChat {
  id           String       @id @default(uuid())
  content      String
  filesUrl     String[]
  sendTime     DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sender       String
  user         User         @relation(fields: [sender], references: [id], onDelete: Cascade)
  group        String
  groupId      ProjectGroup @relation(fields: [group], references: [id])
  messageReply String?
  replyTo      GroupChat?   @relation("GroupChatReplies", fields: [messageReply], references: [id], onDelete: SetNull)
  replies      GroupChat[]  @relation("GroupChatReplies")
}

model Projects {
  id       String         @id
  name     String
  // 'core' | 'specialization' for synced projects; null = legacy junk rows, filtered out of GET /projects.
  category String?
  posts    ProjectsPost[]
}

model ProjectsPost {
  id        String         @id @default(uuid())
  projectId String
  project   Projects       @relation(fields: [projectId], references: [id])
  writer    String
  user      User           @relation(fields: [writer], references: [id], onDelete: Cascade)
  title     String?
  content   String
  filesUrl  String[]
  postedAt  DateTime       @default(now())
  editedAt  DateTime?
  chats     ProjectsChat[]
  votes     PostVote[]
}

model ProjectsChat {
  id            String         @id @default(uuid())
  answeringPost String?
  post          ProjectsPost?  @relation(fields: [answeringPost], references: [id], onDelete: Cascade)
  answeringChat String?
  chat          ProjectsChat?  @relation("AnswerReplies", fields: [answeringChat], references: [id], onDelete: Cascade)
  replies       ProjectsChat[] @relation("AnswerReplies")
  writer        String
  user          User           @relation(fields: [writer], references: [id], onDelete: Cascade)
  content       String
  filesUrl      String[]
  editedAt      DateTime?
  postedAt      DateTime       @default(now())
  votes         ChatVote[]
}

enum VoteValue {
  UP
  DOWN
}

model PostVote {
  vote   VoteValue
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   ProjectsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model ChatVote {
  vote   VoteValue
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String
  chat   ProjectsChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
}
