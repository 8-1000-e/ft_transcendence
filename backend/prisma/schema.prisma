// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  moduleFormat = "cjs"
  provider     = "prisma-client"
  output       = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  //42 data
  ftId          String?        @unique
  ftPfpUrl      String?
  campus        String?
  campusId      String?
  canSuggest    Boolean        @default(true)
  //
  //anon random data
  rdmName       String?
  rdmPfp        String?
  rdmCampus     String?
  //
  name          String
  email         String         @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  groupChats    GroupChat[]
  projectPosts  ProjectsPost[]
  projectChat   ProjectsChat[]
  postVote      PostVote[]
  chatVote      ChatVote[]
  deleteAt      DateTime? // Null = active else deletion programmed
}

model PendingRegistration {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  createdAt          DateTime @default(now())
  verifCode          String
  verifCodeExpiresAt DateTime
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ProjectGroup {
  id          String      @id
  githubLink  String?
  groupName   String
  projectId   String
  groupCampus String?
  projectName String?
  usersId     String[]
  chats       GroupChat[]
}

model GroupChat {
  id           String       @id @default(uuid())
  content      String
  filesUrl     String[]
  sendTime     DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sender       String
  user         User         @relation(fields: [sender], references: [id], onDelete: Cascade)
  group        String
  groupId      ProjectGroup @relation(fields: [group], references: [id])
  messageReply String?
  replyTo      GroupChat?   @relation("GroupChatReplies", fields: [messageReply], references: [id], onDelete: SetNull)
  replies      GroupChat[]  @relation("GroupChatReplies")
}

model Projects {
  id    String         @id
  name  String
  posts ProjectsPost[]
}

model ProjectsPost {
  id        String         @id @default(uuid())
  projectId String
  project   Projects       @relation(fields: [projectId], references: [id])
  writer    String
  user      User           @relation(fields: [writer], references: [id], onDelete: Cascade)
  title     String?
  content   String
  filesUrl  String[]
  postedAt  DateTime       @default(now())
  editedAt  DateTime?
  chats     ProjectsChat[]
  votes     PostVote[]
}

model ProjectsChat {
  id            String         @id @default(uuid())
  answeringPost String?
  post          ProjectsPost?  @relation(fields: [answeringPost], references: [id], onDelete: Cascade)
  answeringChat String?
  chat          ProjectsChat?  @relation("AnswerReplies", fields: [answeringChat], references: [id], onDelete: Cascade)
  replies       ProjectsChat[] @relation("AnswerReplies")
  writer        String
  user          User           @relation(fields: [writer], references: [id], onDelete: Cascade)
  content       String
  filesUrl      String[]
  editedAt      DateTime?      @default(now())
  postedAt      DateTime       @default(now())
  votes         ChatVote[]
}

enum VoteValue {
  UP
  DOWN
}

model PostVote {
  vote   VoteValue
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   ProjectsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model ChatVote {
  vote   VoteValue
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String
  chat   ProjectsChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
}

model GroupRead {
  userId     String
  groupId    String
  lastReadAt DateTime @default(now())

  @@id([userId, groupId])
}
