// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  moduleFormat = "cjs"
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(uuid())
  //42 data
  ftId                String?  @unique
  ftPfpUrl            String?
  campus              String?
  //
  name                String
  email               String   @unique
  passwordHash        String?
  createdAt           DateTime @default(now())
  refreshTokens       RefreshToken[]
  chats               Chats[]
}

model PendingRegistration {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  createdAt           DateTime @default(now())
  verifCode           String
  verifCodeExpiresAt  DateTime
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
}

model ProjectGroup {
  id                  String    @id
  githubLink          String?
  groupName           String
  groupProjectId      String
  groupCampus         String?
  projectName         String?
  usersId             String[]
  chats               Chats[]
}

model Chats {
  id                String       @id @default(uuid())
  content           String
  sendTime          DateTime     @default(now())
  sender            String
  user              User         @relation(fields: [sender], references: [id], onDelete: Cascade)
  group             String
  groupeId          ProjectGroup @relation(fields: [group], references: [id])
}